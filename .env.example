# =========================================================================
# NOVA GLASS — Supabase Backend Configuration (Tahap 4)
# =========================================================================
# Dapatkan kredensial ini dari: Supabase Dashboard -> Project Settings -> API
# Masukkan nilai kredensial nyata ke file .env.local (jangan commit .env.local ke Git!)

VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# KEAMANAN:
# 1. Gunakan hanya "anon key" / "publishable key" untuk frontend.
# 2. JANGAN PERNAH menaruh "service_role key" di file frontend (.env, JS, dll).
# 3. Seluruh proteksi data dijamin melalui PostgreSQL Row Level Security (RLS).

# =========================================================================
# EmailJS — Pengiriman Pesan Nyata Langsung ke Gmail (@emailjs/browser)
# =========================================================================
# Cara Mendapatkan Kredensial Gratis dari https://dashboard.emailjs.com/ :
# 1. Buat akun di EmailJS (gratis 200 email/bulan)
# 2. Email Services -> Add New Service -> Pilih "Gmail" -> Hubungkan ke Gmail Anda -> Catat Service ID (misal: service_abc123)
# 3. Email Templates -> Create New Template -> Buat template dengan variabel:
#    {{from_name}}, {{from_email}}, {{subject}}, {{message}}
#    Atur To Email di settings template ke email Gmail Anda -> Catat Template ID (misal: template_xyz456)
# 4. Account -> API Keys -> Salin "Public Key" Anda (misal: abcdef123456)
# Masukkan nilai-nilai tersebut ke file .env.local:

VITE_EMAILJS_SERVICE_ID=service_1p9wqsg
VITE_EMAILJS_TEMPLATE_ID=template_y5sy7jm
VITE_EMAILJS_PUBLIC_KEY=cgdaJWSvH138VoISL
VITE_EMAILJS_TO_EMAIL=habibtzyeeh25@gmail.com